rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && currentProfile().active == true;
    }

    function roleIs(role) {
      return activeUser() && currentProfile().role == role;
    }

    function canOperate() {
      return roleIs('owner') || roleIs('operator');
    }

    function canAdminister() {
      return roleIs('owner');
    }

    function operationalCollection(name) {
      return name in [
        'collections',
        'fragrances',
        'formats',
        'formatPrices',
        'units',
        'paymentMethods',
        'expenseCategories',
        'expenseTypes',
        'inputs',
        'products',
        'kits',
        'additions',
        'sales',
        'payments',
        'productions',
        'expenses',
        'stockAdjustments',
        'stockMovements'
      ];
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canAdminister());
      allow create, update, delete: if canAdminister();
    }

    match /counters/{documentId} {
      allow read, write: if canOperate();
    }

    match /migrationRuns/{documentId} {
      allow read: if canAdminister();
      allow write: if false;
    }

    match /{collectionName}/{documentId} {
      allow read: if operationalCollection(collectionName) && activeUser();
      allow create, update, delete: if operationalCollection(collectionName) && canOperate();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
