{
  "name": "bem-feito-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "ng": "ng",
    "config:dev": "node tools/config/generate-dev-environment.mjs",
    "security:scan": "node tools/security/check-secrets.mjs",
    "prestart": "npm run config:dev",
    "start": "ng serve --configuration development",
    "build": "ng build",
    "prebuild:dev": "npm run config:dev",
    "build:dev": "ng build --configuration development",
    "prebuild:dev:hosting": "npm run config:dev",
    "build:dev:hosting": "ng build --configuration dev-hosting",
    "build:prod": "ng build --configuration production",
    "test": "vitest run src",
    "test:watch": "vitest",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy:dev": "firebase use dev && npm run build:dev:hosting && firebase deploy --only firestore,hosting",
    "firebase:deploy:prod": "firebase use prod && npm run build:prod && firebase deploy --only firestore,hosting",
    "migration:normalize": "node tools/migration/normalize-legacy.mjs",
    "migration:validate": "node tools/migration/validate-export.mjs",
    "migration:reconcile": "node tools/migration/reconcile.mjs",
    "migration:import": "node tools/migration/import-firestore.mjs",
    "migration:verify": "node tools/migration/verify-firestore.mjs",
    "test:migration": "node --test tools/tests/migration.test.mjs",
    "test:transactions": "firebase emulators:exec --only firestore --project demo-bem-feito \"vitest run tools/tests/transactions.spec.ts\"",
    "admin:user": "node tools/admin/upsert-user.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-bem-feito \"node tools/tests/firestore.rules.test.mjs && node tools/tests/storage.rules.test.mjs\""
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.30.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
