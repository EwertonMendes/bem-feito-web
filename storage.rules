rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().active == true
        && profile().role in ['owner', 'operator', 'viewer'];
    }

    function canOperate() {
      return activeUser() && (profile().role == 'owner' || profile().role == 'operator');
    }

    match /catalog/{allPaths=**} {
      allow read: if activeUser();
      allow write: if canOperate()
        && (request.resource == null
          || (request.resource.size <= 3 * 1024 * 1024
            && request.resource.contentType in ['image/webp', 'image/png', 'image/jpeg', 'image/gif', 'image/avif']));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
