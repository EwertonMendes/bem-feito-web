{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
