{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "bem-feito-drive",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "bem-feito-drive-dev",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "dev",
        "FIREBASE_PROJECT_ID": "bem-feito-dev",
        "FRONTEND_ORIGIN": "https://bem-feito-dev.web.app",
        "GOOGLE_CLIENT_ID": "312978463343-9i9096fr0ccdnbono33mcob32mqdgdlv.apps.googleusercontent.com",
        "OAUTH_REDIRECT_URI": "https://bem-feito-drive-dev.ewertonmendes9.workers.dev/oauth/drive/callback",
        "TOKEN_KEY_VERSION": "v1",
        "OAUTH_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bem-feito-drive-dev",
          "database_id": "baf5dfa3-b9e6-4749-8f64-0cdcf4f482da",
          "migrations_dir": "migrations"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": { "invocation_logs": false }
      }
    }
  }
}
